[
  {
    "id": "single-tap",
    "nameZh": "单指轻点",
    "descriptionZh": "用一根手指轻点触控板，相当于鼠标左键点击。是最基础的手势。",
    "fingerCount": 1,
    "type": "tap",
    "scenarios": ["任何需要点击的场景"],
    "animation": {
      "type": "canvas",
      "fingerStart": [{ "x": 112, "y": 160 }],
      "fingerEnd": [{ "x": 112, "y": 160 }],
      "duration": 400,
      "loop": false
    }
  },
  {
    "id": "two-finger-tap",
    "nameZh": "双指轻点（右键）",
    "descriptionZh": "用两根手指同时轻点触控板，相当于鼠标右键（辅助点按）。",
    "fingerCount": 2,
    "type": "tap",
    "scenarios": ["弹出右键菜单", "复制粘贴上下文菜单"],
    "animation": {
      "type": "canvas",
      "fingerStart": [{ "x": 104, "y": 155 }, { "x": 136, "y": 165 }],
      "fingerEnd": [{ "x": 104, "y": 155 }, { "x": 136, "y": 165 }],
      "duration": 400,
      "loop": false
    }
  },
  {
    "id": "two-finger-scroll",
    "nameZh": "双指滚动",
    "descriptionZh": "用两根手指在触控板上上下滑动来滚动页面或文档。在 Mac 上，默认是「自然滚动」方向（手指上推，页面下滚，像 iPhone）。",
    "fingerCount": 2,
    "type": "scroll",
    "direction": "up",
    "scenarios": ["浏览网页", "阅读文档", "滚动任何可滚动区域"],
    "animation": {
      "type": "canvas",
      "fingerStart": [{ "x": 100, "y": 200 }, { "x": 140, "y": 200 }],
      "fingerEnd": [{ "x": 100, "y": 80 }, { "x": 140, "y": 80 }],
      "paths": [{
        "points": [{ "x": 120, "y": 200 }, { "x": 120, "y": 80 }],
        "color": "rgba(212,165,116,0.4)",
        "width": 2
      }],
      "duration": 1500,
      "loop": true
    }
  },
  {
    "id": "two-finger-scroll-h",
    "nameZh": "双指水平滚动",
    "descriptionZh": "用两根手指左右滑动来水平滚动页面，在查看宽表格或时间线时很有用。",
    "fingerCount": 2,
    "type": "scroll",
    "direction": "left",
    "scenarios": ["水平滚动的页面", "宽表格", "时间线"],
    "animation": {
      "type": "canvas",
      "fingerStart": [{ "x": 160, "y": 140 }, { "x": 160, "y": 180 }],
      "fingerEnd": [{ "x": 80, "y": 140 }, { "x": 80, "y": 180 }],
      "duration": 1500,
      "loop": true
    }
  },
